# Pawfolio AI — environment template.
# Copy to .env.local and fill ONLY .env.local (gitignored). Never put real
# credentials in this file, in git, or in any NEXT_PUBLIC_* variable.

# --------------------------------------------------------------------------
# Existing VoxSOAP configuration (read by src/lib/vox-soap/vox-soap.engine.ts
# and src/app/api/clinic/vox-soap/extract/route.ts)
# --------------------------------------------------------------------------
# Google rotates/retires Gemini model names; the engine has a fallback chain.
VOX_SOAP_MODEL=gemini-3.6-flash
# Cap for uploaded consultation audio (MB) enforced by the extract route.
VOX_SOAP_MAX_AUDIO_MB=25
# Gemini API keys. GEMINI_API_KEYS accepts a comma-separated rotation list
# ("key1,key2,..."); GEMINI_API_KEY is the single-key fallback.
GEMINI_API_KEYS=
GEMINI_API_KEY=

# --------------------------------------------------------------------------
# ML provider knobs (feature branch only — feature/voxsoap-model-integration.md).
# These names are the contract's candidate names; keep this template aligned
# if the Phase 5 wiring renames anything.
# --------------------------------------------------------------------------
# Provider selection must be EXPLICIT (no silent fallback). Allowed values:
#   gemini | ml
VOXSOAP_PROVIDER=gemini
# Python inference service (Phase 4). Loopback by default; never expose it
# publicly without authentication and rate limiting.
VOXSOAP_ML_SERVICE_URL=http://127.0.0.1:8000
# Shared secret for the ML service when reachable beyond loopback.
VOXSOAP_ML_SERVICE_TOKEN=
# ASR (Whisper) component — base checkpoint and optional PEFT adapter path.
VOXSOAP_ASR_MODEL_ID=openai/whisper-small
VOXSOAP_ASR_ADAPTER_PATH=
# SOAP generation component — compatible base model + adapter path.
# A PEFT adapter is NOT a complete model: both paths are required once set.
VOXSOAP_SOAP_BASE_MODEL_ID=
VOXSOAP_SOAP_ADAPTER_PATH=
# Optional Roman Urdu normalization stage (separate task — NOT a Whisper
# capability). Off by default.
VOXSOAP_ROMAN_URDU_ENABLED=false
# Server-side timeout for ML service calls.
VOXSOAP_ML_TIMEOUT_MS=120000

# --------------------------------------------------------------------------
# Panel-facing ML proxy + draft budgets (owner budget realignment 2026-11-05;
# read by src/app/api/voxsoap/[route]/route.ts). Copy into .env.local only
# when the operator deviates from the code defaults (defaults: 20 min proxy
# budget, 320-token CPU draft ceiling — brief rationale inline).
# --------------------------------------------------------------------------
# Passthrough budget: cold bf16-3B draft loads measured 989-1132 s and a
# paged warm draft reached ~1100 s; 900 s 504'd honestly mid-draft. The
# browser client budgets proxy+15 s (voxsoap-ml.client.ts) so the proxy's
# controlled 504 always reaches the panel first.
VOXSOAP_TIMEOUT_MS=1200000
# CPU draft ceiling tokens (read by ml-serving/config.py; with quantized GGUF
# on CPU at ~4.8 tok/s, 512 tokens completes in ~1.5-2 min without truncating
# ASSESSMENT or PLAN on dense 5-minute consultations).
VOXSOAP_DRAFT_MAX_NEW_TOKENS=512

# --------------------------------------------------------------------------
# Quantized GGUF draft backend (owner fix 2026-11-19/20; read by ml-serving/).
# The panel's async job routes are instant (202 + poll + cancel), so draft
# routes have their own short budgets below.
# --------------------------------------------------------------------------
# auto: GGUF on CPU for vet_scribenote when llama_cpp is importable, torch
# otherwise (CUDA always uses torch; the legacy medscribe format always uses
# torch). gguf: honest 503 if llama_cpp is missing - never a silent swap.
VOXSOAP_SOAP_BACKEND=auto
# Local ml-serving/models/<file> is auto-discovered before HuggingFace cache.
# Swap to qwen2.5-3b-instruct-q4_k_m.gguf on faster CPUs if desired.
VOXSOAP_SOAP_GGUF_REPO=Qwen/Qwen2.5-1.5B-Instruct-GGUF
VOXSOAP_SOAP_GGUF_FILE=qwen2.5-1.5b-instruct-q4_k_m.gguf
# Explicit local .gguf path (wins over auto-discovery and repo/file).
# VOXSOAP_SOAP_GGUF_PATH=D:\Pawfolio AI\ml-serving\models\qwen2.5-1.5b-instruct-q4_k_m.gguf
# Context window for the resident GGUF model (>=512; 4096 fits a 5-min
# consult + the 320-token note).
VOXSOAP_SOAP_N_CTX=4096
# Decode threads. 0 = auto (max(2, cpus-1) = 3 on the owner 4-thread box);
# benchmark 2/3/4 on the target machine via bench_soap_gguf.py.
VOXSOAP_SOAP_N_THREADS=3

# Async draft job route budgets (proxy -> FastAPI). Start validates and
# spawns a worker only; status is an in-memory read; cancel flips an Event.
# No socket is held open for the model decode.
VOXSOAP_DRAFT_START_TIMEOUT_MS=30000
VOXSOAP_DRAFT_STATUS_TIMEOUT_MS=15000
VOXSOAP_DRAFT_CANCEL_TIMEOUT_MS=15000
