# Pawfolio AI — environment template.
# Copy to .env.local and fill ONLY .env.local (gitignored). Never put real
# credentials in this file, in git, or in any NEXT_PUBLIC_* variable.

# --------------------------------------------------------------------------
# Existing VoxSOAP configuration (read by src/lib/vox-soap/vox-soap.engine.ts
# and src/app/api/clinic/vox-soap/extract/route.ts)
# --------------------------------------------------------------------------
# Google rotates/retires Gemini model names; the engine has a fallback chain.
VOX_SOAP_MODEL=gemini-3.6-flash
# Cap for uploaded consultation audio (MB) enforced by the extract route.
VOX_SOAP_MAX_AUDIO_MB=25
# Gemini API keys. GEMINI_API_KEYS accepts a comma-separated rotation list
# ("key1,key2,..."); GEMINI_API_KEY is the single-key fallback.
GEMINI_API_KEYS=
GEMINI_API_KEY=

# --------------------------------------------------------------------------
# ML provider knobs (feature branch only — feature/voxsoap-model-integration.md).
# These names are the contract's candidate names; keep this template aligned
# if the Phase 5 wiring renames anything.
# --------------------------------------------------------------------------
# Provider selection must be EXPLICIT (no silent fallback). Allowed values:
#   gemini | ml
VOXSOAP_PROVIDER=gemini
# Python inference service (Phase 4). Loopback by default; never expose it
# publicly without authentication and rate limiting.
VOXSOAP_ML_SERVICE_URL=http://127.0.0.1:8000
# Shared secret for the ML service when reachable beyond loopback.
VOXSOAP_ML_SERVICE_TOKEN=
# ASR (Whisper) component — base checkpoint and optional PEFT adapter path.
VOXSOAP_ASR_MODEL_ID=openai/whisper-small
VOXSOAP_ASR_ADAPTER_PATH=
# SOAP generation component — compatible base model + adapter path.
# A PEFT adapter is NOT a complete model: both paths are required once set.
VOXSOAP_SOAP_BASE_MODEL_ID=
VOXSOAP_SOAP_ADAPTER_PATH=
# Optional Roman Urdu normalization stage (separate task — NOT a Whisper
# capability). Off by default.
VOXSOAP_ROMAN_URDU_ENABLED=false
# Server-side timeout for ML service calls.
VOXSOAP_ML_TIMEOUT_MS=120000
